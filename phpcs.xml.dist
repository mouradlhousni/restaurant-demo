<?xml version="1.0"?>
<ruleset name="Olive &amp; Ember">
	<description>WordPress Coding Standards for the Olive &amp; Ember theme and plugin.</description>

	<file>./themes/olive-ember</file>
	<file>./plugins/oe-reservations</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/assets/vendor/*</exclude-pattern>
	<exclude-pattern>*.js</exclude-pattern>
	<exclude-pattern>*.css</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg name="cache" value=".phpcs-cache"/>
	<arg value="sp"/>

	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="6.5"/>

	<rule ref="WordPress">
		<!--
		The project convention is the short "oe_" prefix for hooks, options and functions
		(classes live in the OliveEmber\Reservations namespace). WPCS refuses prefixes shorter
		than 4 characters, so the prefix sniff is disabled rather than renaming everything.
		-->
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals"/>
	</rule>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="olive-ember"/>
				<element value="oe-reservations"/>
			</property>
		</properties>
	</rule>

	<!-- PSR-4 class files inside a namespace. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>*/plugins/oe-reservations/src/*</exclude-pattern>
		<exclude-pattern>*/plugins/oe-reservations/tests/*</exclude-pattern>
	</rule>

	<!-- Unit tests run outside WordPress and follow PHPUnit naming. -->
	<rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<!-- Test method names are full sentences: a doc comment would only repeat them. -->
	<rule ref="Squiz.Commenting.FunctionComment.Missing">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
</ruleset>
