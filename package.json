{
  "name": "olive-ember",
  "version": "1.0.0",
  "private": true,
  "description": "Olive & Ember – custom WordPress block theme and table reservation plugin (portfolio project).",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:blocks && npm run build:assets",
    "build:blocks": "wp-scripts build --webpack-src-dir=plugins/oe-reservations/blocks --output-path=plugins/oe-reservations/build/blocks --webpack-copy-php",
    "build:assets": "node bin/build-assets.js",
    "start": "wp-scripts start --webpack-src-dir=plugins/oe-reservations/blocks --output-path=plugins/oe-reservations/build/blocks --webpack-copy-php",
    "vendor": "node bin/copy-vendor.js",
    "lint": "npm run lint:php && npm run lint:js && npm run lint:css",
    "lint:php": "composer lint",
    "lint:js": "wp-scripts lint-js plugins/oe-reservations/blocks themes/olive-ember/assets/js",
    "lint:css": "wp-scripts lint-style \"themes/olive-ember/assets/css/**/*.css\" \"plugins/oe-reservations/blocks/**/*.css\" \"plugins/oe-reservations/assets/css/**/*.css\"",
    "test": "composer test",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "seed": "wp-env run cli wp oe seed",
    "export:static": "bash bin/export-static.sh"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@wordpress/env": "^10.39.0",
    "@wordpress/scripts": "^30.27.0",
    "leaflet": "^1.9.4",
    "lightningcss": "^1.33.0",
    "terser": "^5.51.2",
    "typescript": "^5.9.3"
  }
}
